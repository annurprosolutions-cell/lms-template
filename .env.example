# ── Frontend (safe to expose, prefixed VITE_) ──────────────────────────────
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Server-side only (Netlify Functions) — NEVER expose in frontend code ──
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

BAYARCASH_API_TOKEN=your-api-token
BAYARCASH_API_SECRET_KEY=your-api-secret-key
BAYARCASH_PORTAL_KEY=your-portal-key
BAYARCASH_ENV=sandbox
# sandbox base: https://api.console.bayarcash-sandbox.com/v3
# production base: https://api.console.bayar.cash/v3

SITE_URL=http://localhost:5173
